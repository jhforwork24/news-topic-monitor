# Required public contact. Configure as a GitHub Actions repository variable.
MONITOR_CONTACT=monitor@example.org

# Optional safety/operation settings. The request interval cannot be lowered below 2 seconds.
REQUEST_INTERVAL_SECONDS=2.0
CONNECT_TIMEOUT_SECONDS=10
READ_TIMEOUT_SECONDS=20
MAX_RETRIES=2
MAX_DISCOVERY_CHILDREN=20
HANI_MAX_PAGES=50
