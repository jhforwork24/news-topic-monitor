# Required public contact. Configure as a GitHub Actions repository variable.
MONITOR_CONTACT=monitor@example.org

# Optional safety/operation settings. The request interval cannot be lowered below 2 seconds.
REQUEST_INTERVAL_SECONDS=2.0
CONNECT_TIMEOUT_SECONDS=10
READ_TIMEOUT_SECONDS=20
MAX_RETRIES=2
MAX_DISCOVERY_CHILDREN=20
HANI_MAX_PAGES=50

# Optional MBC official-channel discovery. Store the value only as a GitHub Actions secret.
# YOUTUBE_API_KEY is intentionally omitted from this file.

# Optional Notion publication. Keep NOTION_TOKEN in a GitHub Actions secret.
NOTION_PUBLISH_ENABLED=false
NOTION_DATA_SOURCE_ID=
NOTION_REPORTS_DATA_SOURCE_ID=
NOTION_CRPD_REFERENCE_URL=
# NOTION_TOKEN is intentionally omitted: store it only as a GitHub Actions secret.

# Optional two-pass GPT editor. OPENAI_API_KEY must be a GitHub Actions secret.
# The temporary evidence database and article text are deleted when each run ends.
OPENAI_EDITOR_ENABLED=false
OPENAI_EDITOR_MODEL=gpt-5.6
OPENAI_EDITOR_CHUNK_SIZE=20
OPENAI_EDITOR_MAX_CANDIDATES=360
OPENAI_EDITOR_FINAL_CANDIDATES=80
OPENAI_EDITOR_EVIDENCE_CHARS=5000
OPENAI_EDITOR_MAX_RETRIES=2
# OPENAI_API_KEY is intentionally omitted: store it only as a GitHub Actions secret.

# Optional no-API editorial queue for a connected ChatGPT scheduled task.
CHAT_EDITORIAL_ENABLED=true
CHAT_EDITORIAL_MAX_CANDIDATES=180
CHAT_EDITORIAL_CHUNK_SIZE=24
CHAT_EDITORIAL_EVIDENCE_CHARS=1600
CHAT_EDITORIAL_BODY_LIMIT_PER_SOURCE=60
